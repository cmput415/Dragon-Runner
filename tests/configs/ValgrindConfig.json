{
  "testDir": "../packages/MemoryLeaks",
  "testedExecutablePaths": {
    "clang": "/usr/bin/clang",
    "clang2": "/usr/bin/clang"
  },
  "toolchains": {
    "LLVM": [
      {
        "exe": "$EXE",
        "args": [
          "$INPUT",
          "-o",
          "$OUTPUT"
        ],
        "allowError": true
      },
      {
        "exe": "/usr/bin/valgrind",
        "args": [
          "--leak-check=full",
          "--error-exitcode=111",
          "--log-file=/dev/null",
          "$INPUT"
        ],
        "usesInStr": true,
        "allowError": true
      }
    ]
  }
}
