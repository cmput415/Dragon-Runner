{
  "testDir": "testfiles",
  "testedExecutablePaths": {
    "<team_name>": "<path_to_gazc>"
  },
  "runtimes": {
    "<team_name>": "<path_to_libgazrt.so>"
  },
  "toolchains": {
    "gazprea-llc": [
      {
        "exe": "$EXE",
        "args": [
          "$INPUT",
          "$OUTPUT"
        ],
        "allowError": true
      },
      {
        "exe": "/cshome/cmput415/415-resources/llvm-project/build/bin/llc",
        "args": [
          "-filetype=obj",
          "-relocation-model=pic",
          "$INPUT",
          "-o",
          "$OUTPUT"
        ]
      },
      {
        "exe": "/usr/bin/clang",
        "args": [
          "$INPUT",
          "-o",
          "$OUTPUT",
          "-L$RT_PATH",
          "-l$RT_LIB",
          "-lm"
        ]
      },
      {
        "exe": "/usr/bin/valgrind",
        "args": [
          "--leak-check=full",
          "--error-exitcode=111",
          "--log-file=/dev/null",
          "$INPUT"
        ],
        "usesInStr": true,
        "usesRuntime": true,
        "allowError": true
      }
    ]
  }
}
