{
  "testDir": "../packages/RuntimeCPackage",
  "testedExecutablePaths": {
    "clang": "/usr/bin/clang"
  },
  "runtimes": {
    "clang": "../lib/libfib.so"
  },
  "toolchains": {
    "clang-runtime": [
      {
        "exe": "$EXE",
        "args": [
          "-c",
          "$INPUT",
          "-o",
          "$OUTPUT"
        ]
      },
      {
        "exe": "$EXE",
        "args": [
          "$INPUT",
          "-o",
          "$OUTPUT",
          "-L$RT_PATH",
          "-l$RT_LIB"
        ]
      },
      {
        "exe": "$INPUT",
        "usesInStr": true,
        "allowError": true,
        "usesRuntime": true
      }
    ]
  }
}
