{
  "testDir": "../packages/GradePackages",
  "testedExecutablePaths": {
    "team1": "/usr/bin/clang",
    "team2": "/usr/bin/clang",
    "team3": "/usr/bin/clang",
    "TA": "/usr/bin/clang"
  },
  "solutionExecutable": "TA",
  "toolchains": {
    "LLVM": [
      {
        "exe": "$EXE",
        "args": [
          "$INPUT",
          "-o",
          "$OUTPUT"
        ],
        "allowError": true
      },
      {
        "exe": "$INPUT",
        "usesInStr": true,
        "allowError": true
      }
    ],
    "LLVM-opt": [
      {
        "exe": "$EXE",
        "args": [
          "$INPUT",
          "-O3",
          "-o",
          "$OUTPUT"
        ],
        "allowError": true
      },
      {
        "exe": "$INPUT",
        "usesInStr": true,
        "allowError": true
      }
    ]
  }
}
